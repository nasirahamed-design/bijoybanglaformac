<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Bijoy Bangla</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <options customize="never" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_localSystem="true"/>
    <allowed-os-versions>
        <os-version min="13.0"/>
    </allowed-os-versions>
    <choices-outline>
        <line choice="default">
            <line choice="io.spsv.inputmethod.BijoyBangla.pkg"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="io.spsv.inputmethod.BijoyBangla.pkg" visible="false">
        <pkg-ref id="io.spsv.inputmethod.BijoyBangla.pkg"/>
    </choice>
    <!-- RequireLogout: macOS only loads a newly installed input method after a fresh login -->
    <pkg-ref id="io.spsv.inputmethod.BijoyBangla.pkg" version="__VERSION__" onConclusion="RequireLogout">component.pkg</pkg-ref>
</installer-gui-script>
