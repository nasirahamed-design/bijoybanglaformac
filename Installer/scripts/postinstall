#!/bin/bash
# Runs as root after the package is installed. Registers the input method and
# switches it on for the logged-in user. macOS loads a newly installed input
# method at the next login, so the installer then asks the person to log out.
APP="/Library/Input Methods/BijoyBangla.app"
EXE="$APP/Contents/MacOS/BijoyBangla"

/usr/bin/pkill -x BijoyBangla 2>/dev/null || true

login_user="$(/usr/bin/stat -f%Su /dev/console)"
if [ -n "$login_user" ] && [ "$login_user" != "root" ] && [ "$login_user" != "loginwindow" ]; then
  uid="$(/usr/bin/id -u "$login_user")"
  /bin/launchctl asuser "$uid" /usr/bin/sudo -u "$login_user" "$EXE" --register || true
fi
exit 0
